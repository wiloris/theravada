---
/**
 * Иллюстрация внутри текста.
 *
 *   import img from './photo.jpg';
 *   <Figure src={img} alt="…" caption="Подпись" credit="Источник" layout="wide" />
 *
 * layout:
 *   text  — по ширине колонки текста (по умолчанию)
 *   wide  — шире колонки
 *   full  — во всю ширину экрана
 *   left / right — вертикальное изображение с обтеканием текстом
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  layout?: 'text' | 'wide' | 'full' | 'left' | 'right';
}

const { src, alt, caption, credit, layout = 'text' } = Astro.props;
const widths = {
  text: [480, 720, 1080, 1440],
  wide: [720, 1080, 1440, 1920],
  full: [960, 1440, 1920, 2560],
  left: [360, 540, 720],
  right: [360, 540, 720],
}[layout].filter((w) => w <= src.width);
if (!widths.length) widths.push(src.width);
const sizes = {
  text: '(min-width: 44rem) 40rem, 100vw',
  wide: '(min-width: 66rem) 62rem, 100vw',
  full: '100vw',
  left: '(min-width: 44rem) 18rem, 100vw',
  right: '(min-width: 44rem) 18rem, 100vw',
}[layout];
---

<figure class={`fig fig--${layout}`}>
  <button class="fig__zoom" type="button" data-lightbox aria-label={`Открыть изображение: ${alt}`}>
    <Image src={src} alt={alt} widths={widths} sizes={sizes} layout="none" />
  </button>
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span class="fig__caption">{caption}</span>}
        {credit && <span class="fig__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>
